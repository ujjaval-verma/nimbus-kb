{
  "name": "nimbus-kb",
  "description": "Grounded product-knowledge chatbot for NimbusStack.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/node.ts",
    "dev:web": "vite",
    "dev:worker": "vite --mode worker",
    "build": "vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && wrangler deploy --dry-run",
    "deploy": "npm run check && wrangler deploy",
    "record:fixtures": "tsx scripts/record-fixtures.ts",
    "gen:corpus": "tsx scripts/gen-corpus.ts",
    "eval": "tsx evals/run.ts",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@google/genai": "^2.28.0",
    "hono": "^4.13.13",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@cloudflare/vite-plugin": "^1.62.3",
    "@eslint/js": "9.39.1",
    "@hono/node-server": "^2.1.3",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
