{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"], "strict": true, "noEmit": true, "skipLibCheck": true,
    "isolatedModules": true, "moduleDetection": "force", "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src/server/worker.ts", "src/server/app.ts", "src/llm", "src/kb"],
  "exclude": ["src/llm/claude-sub.ts"]
}
