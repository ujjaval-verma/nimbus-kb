# Optional. The Worker answers through the Anthropic API with this key. Local dev uses it only with ANTHROPIC_DEV_API=1.
ANTHROPIC_API_KEY=
# Optional. With a key, Gemini 3.5 Flash-Lite answers too, and is the backup when Claude fails.
GEMINI_API_KEY=
# Local only. Set to 1 to make `npm run dev` use that key (paid) instead of your Claude Code login; without it the key is ignored.
ANTHROPIC_DEV_API=
# Local only. Local dev uses your Claude Code login by default. Set to 0 to disable.
CLAUDE_SUBSCRIPTION=1
# Local only. Force a provider failure to demo fallback, e.g. claude-sonnet:rate_limit or claude-sonnet:midstream
FAULT_INJECT=

# Worker only (the live site): QUOTA_SALT (the secret salt for the daily visitor hash, openssl rand -hex 32) and SITE_PASSWORD
# (the shared site password) belong in .dev.vars (local `npm run dev:worker`) or in Worker secrets (`wrangler secret put`), never in this
# file: the Worker build does not load .env, so a value here has no effect.
