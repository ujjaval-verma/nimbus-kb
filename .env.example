# Optional. With a key, Claude answers through the Anthropic API (marked untested).
ANTHROPIC_API_KEY=
# Local only. Without a key, local dev uses your Claude Code login. Set to 0 to disable.
CLAUDE_SUBSCRIPTION=1
# Local only. Force a provider failure to demo fallback, e.g. claude-sonnet:rate_limit or claude-sonnet:midstream
FAULT_INJECT=
