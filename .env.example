# Optional. The Worker answers through the Anthropic API with this key. Local dev uses it only with ANTHROPIC_DEV_API=1.
ANTHROPIC_API_KEY=
# Local only. Set to 1 to make `npm run dev` use that key (paid) instead of your Claude Code login; without it the key is ignored.
ANTHROPIC_DEV_API=
# Local only. Local dev uses your Claude Code login by default. Set to 0 to disable.
CLAUDE_SUBSCRIPTION=1
# Local only. Force a provider failure to demo fallback, e.g. claude-sonnet:rate_limit or claude-sonnet:midstream
FAULT_INJECT=
