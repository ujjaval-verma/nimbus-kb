{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "bundler",
    "types": ["node"], "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "moduleDetection": "force", "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "jsx": "react-jsx"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "scripts", "evals", "test", "src/server/node.ts", "src/llm/claude-sub.ts"],
  "exclude": ["test/server/worker.test.ts"]
}
